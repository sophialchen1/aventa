# ---------------------------------------------------------------
# Dependencies (installed with `composer install` / `npm install`)
# Never commit these. They are huge and machine-specific.
# ---------------------------------------------------------------
/vendor
/node_modules

# ---------------------------------------------------------------
# Build output (regenerated by `npm run build`)
# The source in resources/ is the truth. Rebuild instead of commit.
# ---------------------------------------------------------------
/public/build
/public/hot
/public/storage
/bootstrap/ssr

# ---------------------------------------------------------------
# Secrets and environment config -- CRITICAL, never commit
# .env holds database passwords, mail credentials, app keys.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
auth.json

# ---------------------------------------------------------------
# Laravel runtime: caches, logs, compiled views, sessions
# ---------------------------------------------------------------
/storage/*.key
/storage/pail
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/logs/*
!.gitignore
/bootstrap/cache/*.php
/.phpunit.cache
/.phpunit.result.cache

# ---------------------------------------------------------------
# Bundled runtimes the previous developer shipped inside the
# handoff folder (PHP 8.3/8.4/8.5, Node). Tooling, not project code.
# ---------------------------------------------------------------
/php-*/
/node-v*/
/nodejs/
/Herramientas/

# ---------------------------------------------------------------
# Editors and OS junk
# ---------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
/.idea
/.vscode
/.zed
/.fleet
/.nova
/.phpactor.json

# ---------------------------------------------------------------
# Logs and misc
# ---------------------------------------------------------------
npm-debug.log*
yarn-error.log*
*.log
